<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Un sobre para ti</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

<style>
  :root{
    --cream:#FBF3E7;
    --cream-dark:#F2E4CF;
    --kraft:#E4C9A0;
    --kraft-dark:#C9A265;
    --ink:#4A362E;
    --ink-soft:#7A5C4E;
    --rose:#D97A93;
    --yellow:#F5B915;
    --yellow-deep:#E29A0A;

    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }

  *{
    box-sizing:border-box;
  }

  html,body{
    height:100%;
    margin:0;
    overflow:hidden;
  }

  body{
    background:
      radial-gradient(ellipse at 20% 15%, #FFF8ED 0%, transparent 55%),
      radial-gradient(ellipse at 85% 85%, #F6E6CE 0%, transparent 50%),
      var(--cream);

    font-family:'Cormorant Garamond', serif;
    color:var(--ink);
    min-height:100%;

    display:flex;
    align-items:center;
    justify-content:center;

    position:relative;
  }

  .stage{
    position:relative;
    width:100%;
    max-width:520px;
    height:100vh;

    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;

    padding:16px 24px;
  }

  .prompt{
    position:absolute;
    top:14vh;

    font-family:'Caveat', cursive;
    font-size:clamp(1.7rem, 5vw, 2.3rem);
    color:var(--ink-soft);
    letter-spacing:.3px;

    margin:0;
    opacity:0;

    transform:translateY(-10px);

    transition:
      opacity .5s ease .1s,
      transform .5s ease .1s;

    z-index:10;
    text-align:center;
    pointer-events:none;
  }

  .prompt.show{
    opacity:1;
    transform:translateY(0);
  }

  .prompt.fade{
    opacity:0;
    transition:opacity .4s ease;
  }

  /* ---- envelope ---- */

  .envelope-wrap{
    position:relative;

    width:min(78vw, 300px);
    height:calc(min(78vw, 300px) * 0.66);

    cursor:pointer;

    -webkit-tap-highlight-color:transparent;
    touch-action:manipulation;

    perspective:1200px;

    margin-top:40px;
  }

  .envelope-wrap.opened{
    cursor:default;
  }

  .env-shadow{
    position:absolute;
    left:6%;
    right:6%;
    bottom:-14px;

    height:22px;

    background:
      radial-gradient(
        ellipse,
        rgba(90,60,40,.28) 0%,
        transparent 72%
      );

    filter:blur(2px);

    transition:opacity .6s ease;
  }

  .env-body{
    position:absolute;
    inset:0;

    background:
      linear-gradient(
        155deg,
        var(--kraft) 0%,
        var(--kraft-dark) 100%
      );

    border-radius:6px;

    box-shadow:
      0 18px 34px -14px rgba(90,55,30,.45),
      inset 0 0 0 1px rgba(120,80,40,.18);
  }

  .env-body::before{
    content:"";

    position:absolute;
    inset:0;

    border-radius:6px;

    background-image:
      repeating-linear-gradient(
        115deg,
        rgba(255,255,255,.05) 0 2px,
        transparent 2px 7px
      );

    mix-blend-mode:overlay;
  }

  .env-back-flap-left,
  .env-back-flap-right{
    position:absolute;

    top:0;
    bottom:0;

    width:52%;

    background:
      linear-gradient(
        100deg,
        rgba(0,0,0,.10),
        rgba(0,0,0,0) 60%
      );

    z-index:1;
  }

  .env-back-flap-left{
    left:0;

    clip-path:
      polygon(
        0 0,
        100% 50%,
        0 100%
      );
  }

  .env-back-flap-right{
    right:0;

    clip-path:
      polygon(
        100% 0,
        0 50%,
        100% 100%
      );

    transform:scaleX(-1);
  }

  .env-pocket{
    position:absolute;

    left:0;
    right:0;
    bottom:0;

    height:64%;

    background:
      linear-gradient(
        165deg,
        #EAD3A9,
        var(--kraft-dark)
      );

    clip-path:
      polygon(
        0 100%,
        0 18%,
        50% 62%,
        100% 18%,
        100% 100%
      );

    border-radius:0 0 6px 6px;

    z-index:3;

    box-shadow:
      inset 0 2px 3px rgba(255,255,255,.25);
  }

  .env-flap{
    position:absolute;

    left:0;
    right:0;
    top:0;

    height:64%;

    background:
      linear-gradient(
        155deg,
        #F0D9AE,
        var(--kraft)
      );

    clip-path:
      polygon(
        0 0,
        100% 0,
        50% 78%
      );

    transform-origin:top center;

    transform:rotateX(0deg);

    transition:
      transform .7s cubic-bezier(.5,-0.2,.3,1.2);

    z-index:4;

    border-radius:6px 6px 0 0;

    box-shadow:
      inset 0 -2px 4px rgba(120,80,40,.15);
  }

  .envelope-wrap.opened .env-flap{
    transform:rotateX(178deg);
    z-index:2;
  }

  .wax-seal{
    position:absolute;

    left:50%;
    top:40%;

    width:38px;
    height:38px;

    background:
      radial-gradient(
        circle at 35% 30%,
        #E28A9C,
        var(--rose) 70%
      );

    border-radius:50%;

    transform:translate(-50%,-50%);

    box-shadow:
      0 3px 6px rgba(90,30,40,.35),
      inset 0 -3px 4px rgba(150,50,70,.4);

    z-index:5;

    display:flex;
    align-items:center;
    justify-content:center;

    transition:
      opacity .3s ease,
      transform .3s ease;
  }

  .wax-seal::after{
    content:"♡";

    color:#fff2f4;
    font-size:16px;
    line-height:1;

    transform:translateY(-1px);
  }

  .envelope-wrap.opened .wax-seal{
    opacity:0;

    transform:
      translate(-50%,-50%)
      scale(.4);
  }

  /* ---- yellow flower rain ---- */

  .bloom-field{
    position:fixed;

    inset:0;

    width:100vw;
    height:100vh;

    z-index:6;

    pointer-events:none;

    overflow:hidden;
  }

  .bloom{
    position:absolute;

    top:-60px;

    opacity:0;

    will-change:
      transform,
      opacity;

    animation:
      fall linear forwards;
  }

  @keyframes fall{

    0%{
      opacity:0;

      transform:
        translateY(0)
        translateX(0)
        rotate(var(--rot0,0deg))
        scale(var(--s,1));
    }

    10%{
      opacity:0.9;
    }

    90%{
      opacity:0.9;
    }

    100%{
      opacity:0;

      transform:
        translateY(var(--fall-y,110vh))
        translateX(var(--drift,20px))
        rotate(var(--rot1,360deg))
        scale(var(--s,1));
    }
  }

  /* ---- letter ---- */

  .letter-overlay{
    position:fixed;

    inset:0;

    background:
      rgba(74, 54, 46, 0.55);

    backdrop-filter:blur(3px);

    display:flex;
    align-items:center;
    justify-content:center;

    padding:28px;

    opacity:0;

    pointer-events:none;

    transition:
      opacity .45s ease;

    z-index:20;
  }

  .letter-overlay.show{
    opacity:1;
    pointer-events:auto;
  }

  .letter-card{
    position:relative;

    width:min(92vw, 420px);

    background:
      linear-gradient(
        180deg,
        #FFFCF6,
        var(--cream)
      );

    border-radius:3px;

    padding:44px 34px 38px;

    box-shadow:
      0 30px 60px -20px rgba(60,35,20,.55);

    transform:
      translateY(28px)
      scale(.94);

    transition:
      transform .5s cubic-bezier(.2,1,.3,1);

    text-align:center;
  }

  .letter-overlay.show .letter-card{
    transform:
      translateY(0)
      scale(1);
  }

  .letter-card::before{
    content:"";

    position:absolute;

    inset:10px;

    border:
      1px solid rgba(180,140,90,.35);

    pointer-events:none;
  }

  .letter-heart{
    font-size:30px;

    color:var(--rose);

    display:inline-block;

    margin-bottom:14px;

    animation:
      beat 1.3s ease-in-out infinite;
  }

  @keyframes beat{

    0%,100%{
      transform:scale(1);
    }

    25%{
      transform:scale(1.14);
    }

    40%{
      transform:scale(.98);
    }
  }

  .letter-text{
    font-size:
      clamp(
        1.15rem,
        3.4vw,
        1.4rem
      );

    line-height:1.65;

    color:var(--ink);

    font-style:italic;

    margin:
      0 0 20px;
  }

  .letter-sign{
    font-family:'Caveat', cursive;

    font-size:1.8rem;

    color:var(--rose);

    line-height:1.2;
  }

  .close-btn{
    margin-top:26px;

    background:none;

    border:
      1px solid var(--kraft-dark);

    color:var(--ink-soft);

    font-family:
      'Cormorant Garamond',
      serif;

    font-size:1rem;

    letter-spacing:.4px;

    padding:
      9px 22px;

    border-radius:999px;

    cursor:pointer;

    transition:
      background .25s ease,
      color .25s ease;
  }

  .close-btn:hover,
  .close-btn:focus-visible{
    background:var(--kraft);
    color:var(--ink);
  }

  .close-btn:focus-visible{
    outline:
      2px solid var(--rose);

    outline-offset:2px;
  }

  .envelope-wrap:focus-visible{
    outline:
      2px solid var(--rose);

    outline-offset:6px;

    border-radius:8px;
  }
</style>
</head>

<body>

<div class="stage">

  <p class="prompt" id="prompt">
    presiona la pantalla
  </p>

  <div
    class="envelope-wrap"
    id="envelope"
    role="button"
    tabindex="0"
    aria-label="Abrir el sobre"
  >

    <div class="env-shadow"></div>

    <div class="env-body"></div>

    <div class="env-back-flap-left"></div>

    <div class="env-back-flap-right"></div>

    <div class="env-pocket"></div>

    <div class="env-flap"></div>

    <div class="wax-seal"></div>

  </div>
</div>


<div
  class="bloom-field"
  id="bloomField">
</div>


<div
  class="letter-overlay"
  id="letterOverlay">

  <div class="letter-card">

    <span class="letter-heart">
      ❤
    </span>

    <p class="letter-text">
      Sé que ahora estamos lejos y no puedo darte esto físicamente, pero sí puedo darte estas flores por aquí.<br>
      Sé que no es lo mismo, ni equivale a la mitad de lo que significa darte un ramo en persona, pero aun así puedo darte mi cariño sincero.
    </p>

    <div class="letter-sign">
      Te quiere,<br>
      Bruno ❤
    </div>

    <div>
      <button
        class="close-btn"
        id="closeLetter">
        cerrar
      </button>
    </div>

  </div>
</div>


<script>
(function(){

  const envelope =
    document.getElementById('envelope');

  const bloomField =
    document.getElementById('bloomField');

  const prompt =
    document.getElementById('prompt');

  const overlay =
    document.getElementById('letterOverlay');

  const closeBtn =
    document.getElementById('closeLetter');


  let opened = false;

  let letterShown = false;

  let spawnTimer = null;


  function flowerSVG(){

    return `
      <svg
        width="42"
        height="42"
        viewBox="0 0 46 46"
        xmlns="http://www.w3.org/2000/svg">

        <g>

          <ellipse
            cx="23"
            cy="10"
            rx="7"
            ry="9"
            fill="#F5B915"/>

          <ellipse
            cx="23"
            cy="36"
            rx="7"
            ry="9"
            fill="#F5B915"/>

          <ellipse
            cx="10"
            cy="23"
            rx="9"
            ry="7"
            fill="#F5B915"/>

          <ellipse
            cx="36"
            cy="23"
            rx="9"
            ry="7"
            fill="#F5B915"/>

          <ellipse
            cx="13.5"
            cy="13.5"
            rx="7"
            ry="8.5"
            fill="#F7C43B"
            transform="rotate(45 13.5 13.5)"/>

          <ellipse
            cx="32.5"
            cy="13.5"
            rx="7"
            ry="8.5"
            fill="#F7C43B"
            transform="rotate(-45 32.5 13.5)"/>

          <ellipse
            cx="13.5"
            cy="32.5"
            rx="7"
            ry="8.5"
            fill="#F7C43B"
            transform="rotate(-45 13.5 32.5)"/>

          <ellipse
            cx="32.5"
            cy="32.5"
            rx="7"
            ry="8.5"
            fill="#F7C43B"
            transform="rotate(45 32.5 32.5)"/>

          <circle
            cx="23"
            cy="23"
            r="7.5"
            fill="#E29A0A"/>

        </g>

      </svg>
    `;
  }


  function spawnFlower(){

    const div =
      document.createElement('div');

    div.className = 'bloom';


    const startX =
      Math.random() * 100;

    const drift =
      (Math.random() * 140 - 70) + 'px';

    const rot0 =
      Math.floor(
        Math.random() * 60 - 30
      );

    const rot1 =
      rot0 +
      (Math.random() > .5 ? 1 : -1) *
      (220 + Math.random() * 180);

    const scale =
      0.7 + Math.random() * 0.7;


    // Lluvia lenta y constante
    // entre 14 y 22 segundos

    const duration =
      14 + Math.random() * 8;

    const fallY =
      (window.innerHeight + 140) + 'px';


    div.style.left =
      startX + 'vw';

    div.style.setProperty(
      '--drift',
      drift
    );

    div.style.setProperty(
      '--rot0',
      rot0 + 'deg'
    );

    div.style.setProperty(
      '--rot1',
      rot1 + 'deg'
    );

    div.style.setProperty(
      '--s',
      scale
    );

    div.style.setProperty(
      '--fall-y',
      fallY
    );

    div.style.animationDuration =
      duration + 's';


    div.innerHTML =
      flowerSVG();


    bloomField.appendChild(div);


    div.addEventListener(
      'animationend',
      () => div.remove()
    );
  }


  function startFlowerRain(){

    // Generar bastantes flores al inicio

    for(let i = 0; i < 20; i++){

      setTimeout(
        spawnFlower,
        i * 120
      );
    }


    // Lluvia continua

    spawnTimer =
      setInterval(
        spawnFlower,
        250
      );
  }


  function openEnvelope(){

    if(opened) return;

    opened = true;

    envelope.classList.add('opened');

    envelope.setAttribute(
      'aria-label',
      'Sobre abierto, toca para ver la carta'
    );

    startFlowerRain();


    setTimeout(
      () => {
        prompt.classList.add('show');
      },
      400
    );
  }


  function showLetter(){

    if(letterShown) return;

    letterShown = true;

    prompt.classList.add('fade');

    overlay.classList.add('show');
  }


  function handleActivate(e){

    if(e) e.stopPropagation();


    if(!opened){

      openEnvelope();

    } else if(!letterShown){

      showLetter();

    }
  }


  envelope.addEventListener(
    'click',
    handleActivate
  );


  envelope.addEventListener(
    'keydown',
    function(e){

      if(
        e.key === 'Enter' ||
        e.key === ' '
      ){

        e.preventDefault();

        handleActivate();
      }
    }
  );


  document.body.addEventListener(
    'click',
    function(e){

      if(
        opened &&
        !letterShown &&
        !overlay.contains(e.target)
      ){

        showLetter();
      }
    }
  );


  closeBtn.addEventListener(
    'click',
    function(e){

      e.stopPropagation();

      overlay.classList.remove('show');
    }
  );


  overlay.addEventListener(
    'click',
    function(e){

      if(e.target === overlay){

        overlay.classList.remove('show');
      }
    }
  );

})();
</script>

</body>
</html>
